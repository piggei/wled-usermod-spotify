{
  "name": "wled-usermod-spotify",
  "version": "0.1.0-dev.2n-vorbis-r7",
  "description": "Spotify Connect receiver + local Ogg/Vorbis decoder qualification usermod for WLED on Waveshare ESP32-S3 RGB Matrix",
  "keywords": [
    "wled",
    "spotify",
    "spotify-connect",
    "audio",
    "esp32",
    "esp32-s3",
    "es8311",
    "usermod"
  ],
  "frameworks": "arduino",
  "platforms": "espressif32",
  "build": {
    "libArchive": false,
    "srcDir": ".",
    "srcFilter": [
      "+<*.cpp>",
      "+<audio/*.cpp>",
      "+<spotify/*.cpp>",
      "+<decoder/*.cpp>"
    ]
  },
  "dependencies": [
    {
      "owner": "esphome",
      "name": "micro-vorbis",
      "version": "^0.1.0",
      "platforms": "espressif32"
    }
  ]
}
